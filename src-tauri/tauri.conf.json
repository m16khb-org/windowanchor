{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WindowAnchor",
  "version": "0.1.0",
  "identifier": "com.windowanchor.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WindowAnchor",
        "width": 1440,
        "height": 920,
        "minWidth": 1080,
        "minHeight": 720,
        "center": true,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Window layouts that stay put.",
    "longDescription": "WindowAnchor remembers window size and position per app, across displays and resolutions, and restores your layout when your monitor setup changes."
  }
}
